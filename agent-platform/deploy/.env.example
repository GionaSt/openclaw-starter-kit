# deploy/.env.example — copia in deploy/.env (gitignorato) e valorizza.
# `docker compose` in deploy/ carica automaticamente deploy/.env.

# Segreto obbligatorio: token subscription Max (nessuna ANTHROPIC_API_KEY).
CLAUDE_CODE_OAUTH_TOKEN=

# Immagine della piattaforma (nel repo non c'è Dockerfile: buildata fuori).
# Valore host confermato: docker inspect .Config.Image = "agent-platform"
# (SENZA tag, 2026-07-27; Docker lo risolve implicitamente a :latest).
PLATFORM_IMAGE=agent-platform

# Porta host. Bind SOLO loopback perché davanti c'è nginx dockerproxy
# (docker inspect PortBindings, 2026-07-27: 127.0.0.1:18800 -> 3100/tcp).
PLATFORM_PORT=127.0.0.1:18800

# Tetto memoria del container in MB. DEVE restare allineato a mem_limit nel
# compose così l'admission-control conosce il tetto reale (OOM cgroup = causa
# dominante run interrotte, wiki: diagnosi-run-interrotte.md).
# Valore host confermato (docker inspect .HostConfig.Memory = 1536 MB, 2026-07-27).
AGENT_PLATFORM_MEM_LIMIT_MB=1536

# Ricerca web read-only per gli Architect V2 (task D1). OPZIONALE: se vuota la
# capacita web resta spenta. Stessa chiave del plugin tavily di OpenClaw
# (openclaw.json -> plugins.entries.tavily.config.webSearch.apiKey).
TAVILY_API_KEY=
