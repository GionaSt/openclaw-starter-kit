# Global backup config. Copy to /root/.backup-global/backup-global.env (chmod 600).
# install-host.sh creates it from this file if missing. Every value has a sane default.

# --- Where the backups go ---------------------------------------------------
# restic repository on top of an rclone remote. "gdrive" is the rclone remote name
# you created with `rclone config` (Google Drive); "OpenClaw_Restic" is the folder
# restic creates inside that Drive. Any rclone backend works (S3, B2, Dropbox, ...).
RESTIC_REPOSITORY="rclone:gdrive:OpenClaw_Restic"
RESTIC_PASSWORD_FILE="/root/.backup-global/restic.pass"

# --- What gets backed up ----------------------------------------------------
# OpenClaw state dir (config, credentials, sessions, workspace, memory).
OPENCLAW_HOME="/root/.openclaw"
# Directory holding your OpenClaw docker-compose.yml (used by restore to bring it up).
OPENCLAW_COMPOSE_DIR="/root/openclaw"
# Extra host paths to include, space separated (optional).
EXTRA_PATHS=""
# Docker volumes whose name starts with this prefix are backed up from the host
# filesystem (e.g. extra OpenClaw instances for family members). Empty = none.
DOCKER_VOLUME_PREFIX="openclaw_"
# Optional: pg_dump of an external Postgres database (Supabase etc.), port 5432
# direct connection, NOT the pooler. Empty = skipped (reported as a gap, not an error).
PG_DUMP_URL=""

# --- Retention (snapshots kept) --------------------------------------------
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
KEEP_YEARLY=2

# --- Safety ------------------------------------------------------------------
# Refuse to start if free space on /root is below this (MB).
MIN_FREE_MB=3000

# --- Notifications (optional) -----------------------------------------------
# Telegram bot token + chat id to receive the nightly report. Empty = no message.
TG_TOKEN=""
TG_CHAT=""

# --- Local lightweight copy (config only, 3 days, no Drive needed) ----------
LOCAL_CONFIG_DIR="/root/backups/global-config"

# Where last-run.json and backup-global.log are written so the assistant can read
# them from inside its container. Default: <OPENCLAW_HOME>/workspace/tools/backup-global
#STATUS_DIR=""
